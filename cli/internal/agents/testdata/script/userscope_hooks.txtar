  "claude": {"marketplace": "MARKET", "marketplace_name": "piste-local", "plugin": "piste-harness@piste-local", "version": "0.0.0-bbbb",
             "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "\"$HOME/.local/share/piste-agents/hooks/bin/piste-guard\"", "timeout": 45}]}]}},
  "codex": {"target": ".codex/hooks.json",
            "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "\"$HOME/.local/share/piste-agents/hooks/bin/piste-guard\"", "timeout": 60}]}]}}}}
