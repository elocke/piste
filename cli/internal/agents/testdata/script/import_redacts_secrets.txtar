# import_redacts_secrets: a literal bearer in a Claude MCP
# header → the manifest references the environment; the command warns; the
# literal is never written (and is removed from .mcp.json).

mkdir proj/.git
cd proj
exec piste agents init --adopt --zone personal $RS
stderr 'warning: mcp data-feed: header Authorization held a literal secret; now \$\{DATA_FEED_TOKEN\}'
stderr 'warning: mcp gh: env GITHUB_TOKEN held a literal secret'
grep 'bearerEnv = .DATA_FEED_TOKEN.' .agents/agents.toml
grep 'secretEnv = \[.GITHUB_TOKEN.\]' .agents/agents.toml
! grep 'sk-live' .agents/agents.toml
! grep 'ghp_' .agents/agents.toml
! grep 'sk-live' .mcp.json
! grep 'ghp_' .mcp.json
! grep 'sk-live' .agents/agents.lock
grep 'Bearer \$\{DATA_FEED_TOKEN\}' .mcp.json
grep '"LOG_LEVEL": "debug"' .mcp.json

-- proj/.mcp.json --
{
  "mcpServers": {
    "data-feed": {
      "type": "http",
      "url": "https://mcp.example/data-feed",
      "headers": { "Authorization": "Bearer sk-live-abcdefghijklmnopqrstu" }
    },
    "gh": {
      "command": "github-mcp",
      "env": { "GITHUB_TOKEN": "ghp_abcdefghijklmnopqrstuvwxyz0123", "LOG_LEVEL": "debug" }
    }
  }
}
