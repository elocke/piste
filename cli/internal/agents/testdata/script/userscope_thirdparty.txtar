 "thirdParty": [{"file": "agents.base.toml", "path": "WORK/base/agents.base.toml"}, {"file": "agents.toml", "path": "WORK/agents/agents.toml"}, {"file": "agents.lock", "path": "WORK/agents/agents.lock"}]}
