-- zone-agents.toml --
[policy]
allow = ["github:o/*", "url:https://raw.githubusercontent.com/o/*", "npm:*", "codex:*", "pypi:*"]
tolerate = ["claude.plugin:keep@*", "claude.marketplace:strayM*"]
unlisted = "warn"

[[skill]]
name = "locked"
source = "github:o/skills"
path = "skills/locked"
ref = "v1.2"

[[skill]]
name = "unlocked"
source = "github:o/skills"
path = "skills/unlocked"

[[skill]]
name = "stale"
source = "github:o/skills"
path = "skills/moved"

[[skill]]
name = "blocked"
source = "github:evil/x"

[[claude.marketplace]]
name = "good"
source = "github:o/good"

[[claude.marketplace]]
name = "drift"
source = "github:o/drift"

[[claude.marketplace]]
name = "src"
source = "github:o/src"
pin = "source"

[[claude.marketplace]]
name = "new"
source = "github:o/new"

[[claude.marketplace]]
name = "urlm"
source = "url:https://raw.githubusercontent.com/o/cfg/main/plugins/.claude-plugin/marketplace.json"

[[claude.plugin]]
id = "ok@good"

[[claude.plugin]]
id = "old@good"

[[claude.plugin]]
id = "off@good"

[[claude.plugin]]
id = "float@src"

[[claude.plugin]]
id = "missing@good"

[[claude.plugin]]
id = "quiet@good"
enabled = false

[[claude.plugin]]
id = "lsp@urlm"

[[claude.plugin]]
id = "pua@urlm"
enabled = false

[[claude.plugin]]
id = "gone@urlm"
enabled = false

[[claude.plugin]]
id = "elsewhere@new"
hosts = ["some-other-host"]

[[codex.plugin]]
id = "github@openai-curated"

[[codex.plugin]]
id = "canva@openai-curated"

[[codex.plugin]]
id = "figma@openai-curated"

[[mcp]]
name = "playwright"
command = "npx"
args = ["-y", "@playwright/mcp@0.0.83"]

[[mcp]]
name = "uvtool"
command = "/usr/bin/uvx"
args = ["--from", "x", "mcp-thing==1.2"]

[[mcp]]
name = "local"
command = "demo-mcp"

[[hook]]
name = "hindsight"
mode = "managed"
installer = "npm:@vectorize-io/hindsight-coding-agents"
version = "0.7.0"
versionFile = "~/.hindsight/package.json"

[[hook]]
name = "paseo"
mode = "tolerated"

[[tool]]
name = "githits"
source = "npm:githits"
version = "0.6.6"

[[tool]]
name = "drifty"
source = "npm:drifty"
version = "2.0.0"

[[tool]]
name = "rtk"
source = "nix:piste#rtk"
bins = ["rtk-not-on-path"]

[[tool]]
name = "weird"
source = "brew:weird"
-- zone-agents.lock --
