# toml_comments_preserved: every line outside the managed
# block is byte-identical after sync; a duplicate-key injection aborts with
# no write.

mkdir proj/.git
cd proj
cp .codex/config.toml config.orig

exec piste agents add shared:mcp/demo $RS
prefix config.orig .codex/config.toml
grep '^# >>> piste:managed mcp$' .codex/config.toml
exec piste agents remove shared:mcp/demo $RS
cmp .codex/config.toml config.orig

# A hand-written [mcp_servers.demo] would duplicate our table: abort, write nothing.
cp dup.toml .codex/config.toml
cp dup.toml dup.orig
! exec piste agents add shared:mcp/demo $RS
stderr 'invalid|already'
cmp .codex/config.toml dup.orig
! exists .mcp.json
! grep 'shared:mcp/demo' .agents/agents.toml

-- proj/.agents/agents.toml --
zone = "personal"
harnesses = ["claude", "codex"]
-- proj/.codex/config.toml --
# Codex config
# Added by bosun
model = "gpt-5" # inline

