# remove_only_locked: with 25 hand skills + 2 ours, remove
# leaves exactly 25. Unowned items are reported as unknown, never deleted.

mkdir proj/.git
cd proj
exec piste agents add shared:skill/alpha shared:skill/gamma $RS
countdir 27 .claude/skills

exec piste agents drift $RS
stdout '^unknown +\.claude/skills/hand00'

exec piste agents remove shared:skill/alpha shared:skill/gamma $RS
countdir 25 .claude/skills
! exists .agents/skills/alpha
! exists .agents/skills/gamma
exists .claude/skills/hand24/SKILL.md

-- proj/.agents/agents.toml --
zone = "personal"
harnesses = ["claude", "codex"]
-- proj/.claude/skills/hand00/SKILL.md --
---
name: hand00
description: hand-made 0
---
