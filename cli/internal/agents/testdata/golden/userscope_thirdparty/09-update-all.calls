git -C $WORK/.tmp/piste-agents-update-TMP/mirrors/good fetch --quiet origin aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
git -C $WORK/.tmp/piste-agents-update-TMP/mirrors/good -c advice.detachedHead=false checkout --quiet aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
claude plugin marketplace add $WORK/.tmp/piste-agents-update-TMP/mirrors/good
git clone --quiet https://github.com/o/new.git $WORK/.tmp/piste-agents-update-TMP/mirrors/new
