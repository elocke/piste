yq keys | .[] | select(. != "sops") $WORK/flake/secrets/b.sops.yaml
yq keys | .[] | select(. != "sops") $WORK/flake/secrets/env/a.sops.yaml
yq .. | select(tag == "!!str") | path | .[-1] $WORK/flake/secrets/b.sops.yaml
yq .. | select(tag == "!!str") | path | .[-1] $WORK/flake/secrets/env/a.sops.yaml
