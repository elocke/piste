nix eval --json --override-input piste git+file://$WORK/ck $WORK/ck/overlays/mine#. --apply o: { darwin = builtins.attrNames (o.darwinConfigurations or { }); home = builtins.attrNames (o.homeConfigurations or { }); nixos = builtins.attrNames (o.nixosConfigurations or { }); }
nix eval --json $WORK/ck/overlays/mine#nixosConfigurations."testhost".config --override-input piste git+file://$WORK/ck --apply (user: config: let inherit (builtins) any elem length; u = config.users.users.${user} or null; ssh = config.services.openssh; sudo = config.security.sudo; loader = config.boot.loader; root = config.fileSystems."/" or null; forUser = r: elem user r.users || elem "wheel" r.groups; nopasswd = c: builtins.isAttrs c && c.command == "ALL" && elem "NOPASSWD" c.options; passwords = [ "hashedPassword" "hashedPasswordFile" "password" "initialPassword" "initialHashedPassword" ]; in { SSHEnabled = ssh.enable; PasswordAuth = ssh.settings.PasswordAuthentication == true; KbdInteractive = ssh.settings.KbdInteractiveAuthentication == true; KeysInHomedir = ssh.authorizedKeysInHomedir or true; Keys = if u == null then 0 else length u.openssh.authorizedKeys.keys; KeyFiles = if u == null then 0 else length u.openssh.authorizedKeys.keyFiles; PermitRootLogin = if ssh.settings.PermitRootLogin == null then "" else ssh.settings.PermitRootLogin; Wheel = (u != null && (elem "wheel" u.extraGroups || u.group == "wheel")) || elem user (config.users.groups.wheel.members or [ ]); SudoEnabled = sudo.enable; WheelNeedsPassword = sudo.wheelNeedsPassword; NopasswdForUser = any (r: forUser r && any nopasswd r.commands) sudo.extraRules; HasPassword = u != null && any (o: u.${o} != null) passwords; BootLoader = loader.systemd-boot.enable || (loader.grub.enable && (loader.grub.devices != [ ] || loader.grub.mirroredBoots != [ ])) || loader.generic-extlinux-compatible.enable || (loader.external.enable or false) || (loader.limine.enable or false) || (loader.refind.enable or false); IsContainer = config.boot.isContainer; RootDevice = if root == null || root.device == null then "" else root.device; }) "jane" --no-write-lock-file
findmnt -no SOURCE /
nix eval --json $WORK/ck/overlays/mine#. --override-input piste git+file://$WORK/ck --apply o: builtins.attrNames (o.nixosConfigurations or { }) --no-write-lock-file
nix build $WORK/ck/overlays/mine#nixosConfigurations."testhost".config.system.build.toplevel --override-input piste git+file://$WORK/ck
nix eval --json $WORK/ck/overlays/mine#nixosConfigurations."testhost".config --override-input piste git+file://$WORK/ck --apply c: { hostName = c.networking.hostName; proxmoxLXC = (c.proxmoxLXC.enable or false) && !(c.proxmoxLXC.manageNetwork or false) && !(c.proxmoxLXC.manageHostName or false); proxmoxCloudInit = c.proxmox.cloudInit.enable or false; } --no-write-lock-file
