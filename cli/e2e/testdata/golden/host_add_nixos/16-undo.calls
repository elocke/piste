nix eval --json --override-input piste git+file://$WORK/ck $WORK/ck/overlays/bare#. --apply o: { darwin = builtins.attrNames (o.darwinConfigurations or { }); home = builtins.attrNames (o.homeConfigurations or { }); nixos = builtins.attrNames (o.nixosConfigurations or { }); }
