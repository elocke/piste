# switch, rollback and secrets: external argv (shims, incl. sudo), exit
# codes, messages and files written.
# piste reads/generates the age key with filippo.io/age, so no `age-keygen`
# calls appear. Outputs are frozen in $GOLDEN/switch_rollback_secrets.

chmod 0755 scenario.sh
chmod 0755 fakebin/piste-secrets-rotate
env USER=tester

# A real age key, generated by Go (filippo.io/age), in age-keygen's format.
mkdir keyflake
cd keyflake
exec git init -q -b master
cp $WORK/fx/flake.nix flake.nix
env HOME=$WORK/keyhome
exec piste secrets init
stdout '^Created age key: .*/keyhome/.config/sops/age/keys.txt$'
stdout '^  Public key: age1[a-z0-9]{58}$'
stdout '^Secrets infrastructure ready.$'
grep '^# created: ' $WORK/keyhome/.config/sops/age/keys.txt
grep '^# public key: age1' $WORK/keyhome/.config/sops/age/keys.txt
grep '^AGE-SECRET-KEY-1[A-Z0-9]{58}$' $WORK/keyhome/.config/sops/age/keys.txt
grep '^  - &testhost age1' .sops.yaml
stdout 'Keep a copy of it in a password manager'
exists secrets/env
# the key is not replaced, and init is idempotent
exec piste secrets init
stdout '^Age key already exists: '
stdout '^.sops.yaml already exists: '
env HOME=$WORK/home
cd $WORK

exec sh scenario.sh
# Not vacuous: the shims were really reached.
[linux] grep '^home-manager switch -b backup-N --flake .*/flake#tester@linux$' out/01-switch.calls
[linux] grep '^home-manager switch -b backup-N --flake .*/flake#tester@b --show-trace$' out/03-switch-host-verbose.calls
[linux] grep '^home-manager switch -b backup-N --flake .*/piste/overlays/o#tester@linux --override-input piste git\+file://.*/piste$' out/05-switch-checkout.calls
[darwin] grep '^sudo darwin-rebuild switch --flake .*/flake#hh$' out/02-switch-host.calls
[darwin] grep '^sudo darwin-rebuild switch --flake .*/piste/overlays/o#testhost --override-input piste git\+file://.*/piste$' out/05-switch-checkout.calls
# On a Mac the inputs are fetched as the user first, then root switches.
[darwin] grep '(?s)nix flake archive --json \S+/flake\n.*sudo darwin-rebuild switch --flake \S+/flake#hh' out/02-switch-host.calls
[darwin] grep '(?s)nix flake archive --json \S+/piste/overlays/o --override-input piste git\+file://\S+/piste\n.*sudo darwin-rebuild switch' out/05-switch-checkout.calls
[darwin] grep 'doesn.t match any darwinConfigurations' out/07-switch-guard.err
# A switch deletes no backup: home-manager's (*.hm-bak, *.backup-<time>)
# and the user's alike.
! grep 'backup removed' out/01-switch.out
! grep 'Cleaned up' out/01-switch.out
grep '^Switch failed \(exit code 3\)$' out/04-switch-fail.err
[linux] grep '^activate$' out/10-rollback-yes.calls
[linux] grep 'Rolled back to generation 41!' out/10-rollback-yes.out
[linux] grep 'Rollback cancelled.' out/14-rollback-no.out
[linux] grep '^Aborted!$' out/15-rollback-eof.err
[darwin] grep '^sudo darwin-rebuild switch --rollback$' out/10-rollback-yes.calls
grep '^  Public key: age1' out/22-secrets-init.out
grep '^  - &testhost age1' out/22-secrets-init.file
grep 'PLAINTEXT' out/24-secrets-status.out
grep '^sops -e -i .*/secrets/env/a.sops.yaml$' out/25-secrets-edit-plain.calls
grep '^sops .*/secrets/b.sops.yaml$' out/26-secrets-pick.calls
grep 'enter a number from 1 to 2' out/26-secrets-pick.out
grep '^piste-secrets-rotate --all$' out/30-secrets-plugin.calls
exec sh normalize.sh
cmpworkdir $WORK/out $GOLDEN/switch_rollback_secrets

-- fakebin/piste-secrets-rotate --
#!/bin/sh
echo "piste-secrets-rotate $*" >> "$WORK/calls"
-- scenario.sh --
out=$WORK/out
F=$WORK/flake
rm -rf "$out" "$WORK/replies" "$WORK/home" "$WORK/piste" "$F"
mkdir -p "$out" "$WORK/replies" "$WORK/home" "$F"
cp "$WORK/fx/flake.nix" "$WORK/fx/flake.lock" "$F/"
git -C "$F" init -q
export PATH=$WORK/fakebin:$PATH COLUMNS=500
H=$WORK/home
cd "$F"
run() {
  step=$1; shift
  : > "$WORK/calls"
  piste "$@" >"$out/$step.out" 2>"$out/$step.err" <"$WORK/stdin"
  echo $? > "$out/$step.rc"
  # the timestamped home-manager backup suffix; Go reads the age key itself
  sed 's/ backup-[0-9]*/ backup-N/' "$WORK/calls" | grep -v '^age-keygen -y ' > "$out/$step.calls"
  : > "$WORK/stdin"
}
: > "$WORK/stdin"

# --- switch ---
mkdir -p "$H/.config/app" "$H/.local/a/d.backup"
# A machine home-manager has activated (its gcroot), with the backups its
# switches made: they stay, the second switch's too.
mkdir -p "$H/.local/state/home-manager/gcroots" && touch "$H/.local/state/home-manager/gcroots/current-home"
backups="$H/.config/app/x.hm-bak $H/.zshrc.backup-1790000000 $H/.local/a/b.backup $H/.gitconfig.backup $H/keep.backup"
touch $backups
printf '["tester@linux", "other@box"]' > "$WORK/replies/nix"
run 01-switch switch
for b in $backups; do [ -e "$b" ] || echo "backup removed: $b" >> "$out/01-switch.out"; done
run 02-switch-host switch --host hh
run 03-switch-host-verbose -v switch --host b
SHIM_EXIT_HOME_MANAGER=3 SHIM_EXIT_SUDO=3 run 04-switch-fail switch --host hh
# An overlay in a piste checkout builds against the checkout (git+file).
mkdir -p "$WORK/piste/overlays" "$WORK/piste/.git"; : > "$WORK/piste/flake.nix"; : > "$WORK/piste/.piste"
cp -r "$F" "$WORK/piste/overlays/o"; cp "$WORK/fx/piste-input.lock" "$WORK/piste/overlays/o/flake.lock"
printf '["testhost"]' > "$WORK/replies/nix"
(cd "$WORK/piste/overlays/o" && run 05-switch-checkout switch)
rm -rf "$WORK/piste"
printf '["tester@other", "tester@box"]' > "$WORK/replies/nix"
run 07-switch-guard switch
printf '[]' > "$WORK/replies/nix"
run 08-switch-no-darwin-configs switch
printf 'not json' > "$WORK/replies/nix"
SHIM_EXIT_NIX=1 run 09-switch-eval-fail switch

# --- rollback ---
mkdir -p "$WORK/gen41"
printf '#!/bin/sh\necho activate >> "$WORK/calls"\nexit ${ACT_EXIT:-0}\n' > "$WORK/gen41/activate"
chmod 0755 "$WORK/gen41/activate"
printf '2026-09-30 10:30 : id 42 -> /nix/store/gen42\n2026-09-29 09:00 : id 41 -> %s/gen41\nnoise\n' "$WORK" > "$WORK/replies/home-manager"
run 10-rollback-yes rollback -y
ACT_EXIT=4 run 11-rollback-fail rollback --yes
printf '2026-09-30 10:30 : id 42 -> /nix/store/gen42\n2026-09-29 09:00 : id 40 -> %s/nope\n' "$WORK" > "$WORK/replies/home-manager"
run 12-rollback-missing rollback -y
printf '2026-09-30 10:30 : id 42 -> /nix/store/gen42\n' > "$WORK/replies/home-manager"
run 13-rollback-one-gen rollback -y
printf '2026-09-30 10:30 : id 42 -> /nix/store/gen42\n2026-09-29 09:00 : id 41 -> %s/gen41\n' "$WORK" > "$WORK/replies/home-manager"
printf 'maybe\nn\n' > "$WORK/stdin"
run 14-rollback-no rollback
run 15-rollback-eof rollback
printf 'y\n' > "$WORK/stdin"
run 16-rollback-confirm rollback

# --- secrets ---
run 20-secrets-status-empty secrets status
run 21-secrets-edit-none secrets edit
mkdir -p "$H/.config/sops/age"
cp "$WORK/keyhome/.config/sops/age/keys.txt" "$H/.config/sops/age/keys.txt"
sed -n 's/^# public key: //p' "$H/.config/sops/age/keys.txt" > "$WORK/replies/age-keygen"
run 22-secrets-init secrets init
cp "$F/.sops.yaml" "$out/22-secrets-init.file"
[ -d "$F/secrets/env" ] && echo "secrets/env made" >> "$out/22-secrets-init.out"
run 23-secrets-init-again secrets init
printf 'api_key: x\n' > "$F/secrets/env/a.sops.yaml"
printf 'token: y\nsops:\n  mac: z\n' > "$F/secrets/b.sops.yaml"
printf 'api_key\ntoken\nsops\ntoken\n' > "$WORK/replies/yq"
run 24-secrets-status secrets status
run 25-secrets-edit-plain secrets edit secrets/env/a.sops.yaml
printf 'x\n9\n\n1\n' > "$WORK/stdin"
run 26-secrets-pick secrets edit
run 27-secrets-pick-eof secrets edit
run 28-secrets-edit-missing secrets edit nope.sops.yaml
SHIM_EXIT_SOPS=2 run 29-secrets-sops-fail secrets edit secrets/b.sops.yaml
run 30-secrets-plugin secrets rotate --all
SHIM_EXIT_YQ=1 run 31-secrets-status-unreadable secrets status
exit 0
-- normalize.sh --
# Each run generates a new age key; panels are sized to the work dir path
# (keep their words only, in C-locale
# order); an age since the epoch changes daily. (Portable sed: no -i.)
cd $WORK/out
for f in *; do sed -E 's/age1[a-z0-9]{58}/age1KEY/g; s/AGE-SECRET-KEY-1[A-Z0-9]{58}/AGE-SECRET-KEY-1KEY/g; s/-?[0-9]{4,} days/N days/g' "$f" > "$f.t" && mv "$f.t" "$f"; done
for f in 20-*.out 24-*.out 31-*.out; do
  tr -cs 'A-Za-z0-9@.:/_,-' '\n' < "$f" | grep -v -e '^/' | LC_ALL=C sort | tr '\n' ' ' > "$f.w"; mv "$f.w" "$f"
done
-- fx/flake.nix --
{ outputs = { self }: { homeConfigurations = { }; }; }
-- fx/flake.lock --
{"nodes": {"root": {"inputs": {"nixpkgs": "nixpkgs"}}, "nixpkgs": {"locked": {"lastModified": 4102444800}}}, "root": "root", "version": 7}
-- fx/piste-input.lock --
{"nodes": {"root": {"inputs": {"nixpkgs": "nixpkgs", "piste": "piste"}}, "nixpkgs": {"locked": {"lastModified": 4102444800}}, "piste": {"locked": {"lastModified": 4102444800}}}, "root": "root", "version": 7}
