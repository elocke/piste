-- declared-linux.json --
{"nix": ["piste", "black", "jq"], "casks": ["firefox"], "brews": ["mas"], "exclude": [],
 "files": {"home.packages": ["/nix/store/00000000000000000000000000000001-source/modules/roles/dev.nix", "/nix/store/00000000000000000000000000000002-source/hosts/testhost.nix"]},
 "pkgs": {"ripgrep": {"pname": "ripgrep", "version": "15.2.0"}, "ripgrep-all": {"pname": "ripgrep-all", "version": "0.10.9"},
          "httpie": {"pname": "httpie", "version": "3.2.4"}, "black": {"pname": "black", "version": "25.1.0"}, "jq": {"pname": "jq", "version": "1.8.1"}}}
-- declared-darwin.json --
{"nix": ["piste", "black", "jq"], "casks": ["firefox"], "brews": ["mas"], "exclude": [],
 "files": {"piste.packages.extraPackages": ["/nix/store/00000000000000000000000000000002-source/hosts/testhost.nix"],
           "environment.systemPackages": ["/nix/store/00000000000000000000000000000001-source/modules/platforms/darwin.nix"],
           "piste.packages.casks.extra": ["/nix/store/00000000000000000000000000000002-source/hosts/testhost.nix"],
           "homebrew.casks": ["/nix/store/00000000000000000000000000000001-source/modules/platforms/darwin.nix"],
           "piste.packages.brews.extra": ["/nix/store/00000000000000000000000000000002-source/hosts/testhost.nix"],
           "homebrew.brews": ["/nix/store/00000000000000000000000000000001-source/modules/platforms/darwin.nix"]},
 "pkgs": {"ripgrep": {"pname": "ripgrep", "version": "15.2.0"}, "ripgrep-all": {"pname": "ripgrep-all", "version": "0.10.9"},
          "httpie": {"pname": "httpie", "version": "3.2.4"}, "black": {"pname": "black", "version": "25.1.0"}, "jq": {"pname": "jq", "version": "1.8.1"},
          "tailscale": {"pname": "tailscale", "version": "1.90.6"}}}
-- declared-again.json --
{"nix": ["piste", "black", "jq", "ripgrep-all", "httpie"], "casks": [], "brews": [], "exclude": [],
 "files": {"home.packages": ["/nix/store/00000000000000000000000000000002-source/hosts/testhost.nix"]},
 "pkgs": {"ripgrep-all": {"pname": "ripgrep-all", "version": "0.10.9"}, "httpie": {"pname": "httpie", "version": "3.2.4"},
          "black": {"pname": "black", "version": "25.1.0"}}}
-- declared-nolist.json --
{"nix": ["piste", "black"], "casks": [], "brews": [], "exclude": [],
 "files": {"home.packages": ["/nix/store/00000000000000000000000000000001-source/modules/roles/dev.nix"]},
 "pkgs": {"ripgrep-all": {"pname": "ripgrep-all", "version": "0.10.9"}, "httpie": {"pname": "httpie", "version": "3.2.4"},
          "black": {"pname": "black", "version": "25.1.0"}}}
-- jane/flake.nix --
{ outputs = inputs@{ piste, self, ... }: piste.lib.mkFlake { inherit inputs self; user = "jane"; zone = "personal"; hosts = { }; }; }
-- jane/hosts/testhost.nix --
{ config, pkgs, user, piste, ... }:
{
  home.packages = [ piste.packages.${pkgs.stdenv.hostPlatform.system}.piste ];

  # This Mac's own packages; `piste adopt` adds what you installed outside Nix here.
  piste.packages.extraPackages = with pkgs; [ ];
  piste.packages.casks.extra = [ ];
  piste.packages.brews.extra = [ ];
}
-- jane/modules/js.nix --
{ ... }:
let
  pnpmPackages = [
    "typescript"
  ];
in
{ }
-- jane/modules/devcontainer.nix --
# Not imported by this host (files doesn't name it): never written to.
{ pkgs, ... }:
{
  home.packages = [ ];
  piste.packages.extraPackages = [ ];
}
-- linux-testhost.nix --
{ config, pkgs, user, piste, ... }:
{
  home.packages = [
    piste.packages.${pkgs.stdenv.hostPlatform.system}.piste
    pkgs.ripgrep-all
    pkgs.httpie
  ];

  # This Mac's own packages; `piste adopt` adds what you installed outside Nix here.
  piste.packages.extraPackages = with pkgs; [ ];
  piste.packages.casks.extra = [ ];
  piste.packages.brews.extra = [ ];
}
-- darwin-testhost.nix --
{ config, pkgs, user, piste, ... }:
{
  home.packages = [ piste.packages.${pkgs.stdenv.hostPlatform.system}.piste ];

  # This Mac's own packages; `piste adopt` adds what you installed outside Nix here.
  piste.packages.extraPackages = with pkgs; [
    ripgrep
    ripgrep-all
    httpie
  ];
  piste.packages.casks.extra = [
    "slack"
  ];
  piste.packages.brews.extra = [
    "python@3.12"
    "tailscale"
  ];
}
-- js.nix --
{ ... }:
let
  pnpmPackages = [
    "typescript"
    "prettier"
    "tsx"
  ];
in
{ }
