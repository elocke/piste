# piste leaks: your marker words (lists in the checkout's
# overlays), generic markers and gitleaks (shimmed), over the
# commits no remote has or over an exported tree. Exit 0 clean, 1 a hit,
# 2 couldn't scan. The words here are made up.
exec sh mk.sh

# A bad list line: named by line, exit 2.
! exec piste leaks --markers $WORK/bad.txt $WORK/tree1
stderr 'bad.txt:2: 5 words'
exec sh -c 'piste leaks --markers "$WORK/bad.txt" "$WORK/tree1" 2>/dev/null; echo $?'
stdout '^2$'

# A sha256: line (the hashed form is gone) is an error, not a term that never matches.
! exec piste leaks --markers $WORK/hashed.txt $WORK/tree1
stderr 'hashed.txt:2: sha256: lines are no longer read; put the plain term back'
! stderr 'b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9'

cd co

# Nothing unpushed: clean, with both lists of the checkout's overlays.
exec piste leaks
stdout '^piste leaks: 0 commits not on a remote clean \(generic markers, 2 lists, gitleaks\)$'

# A term from the plain list, in any case and with any separator.
cp $WORK/src/notes.txt notes.txt
exec git add notes.txt
exec git commit -q -m 'add notes'
! exec piste leaks
stdout '^piste leaks: 1 commit not on a remote \(generic markers, 2 lists, gitleaks\)$'
stdout '^✗ [0-9a-f]{7} notes.txt:1  "Plum-Orchard" \(overlays/personal/leak-markers.txt\)$'
stdout '^Take these out of the commits \(amend or rebase\) before you push.$'
exec sh -c 'piste leaks >/dev/null; echo $?'
stdout '^1$'
# gitleaks runs with git log's output pinned, piste's config and an empty
# ignore directory of piste's: nothing in the checkout or git's config turns
# it off.
grep '^gitleaks git --log-opts HEAD --not --remotes --no-color --no-ext-diff --no-textconv --no-show-signature --no-relative --text --src-prefix=a/ --dst-prefix=b/ --format=medium --date=default --no-abbrev-commit --no-decorate --no-banner --redact --log-level error -f json -r - --exit-code 3 --config \S+/piste-gitleaks-\d+/gitleaks\.toml --gitleaks-ignore-path \S+/piste-gitleaks-\d+ \.$' $WORK/calls
exec git reset -q --hard origin/main

# A term only in the work overlay's list.
cp $WORK/src/tern.txt tern.txt
exec git add tern.txt
exec git commit -q -m 'add tern'
! exec piste leaks
stdout '^✗ [0-9a-f]{7} tern.txt:1  "Hidden_Tern" \(overlays/work/leak-markers.personal.txt\)$'
exec git reset -q --hard origin/main

# The pre-push hook (the engine's .githooks/pre-push, on with core.hooksPath
# .githooks as a maintainer sets it) runs piste leaks --pre-push. A clean push
# lands; gitleaks scans the same range.
cp $WORK/src/ok.txt clean.txt
exec git add clean.txt
exec git commit -q -m 'add clean'
exec git push -q origin main
stderr '^piste leaks: 1 commit for origin clean \(generic markers, 2 lists, gitleaks\)$'
grep '^gitleaks git --log-opts [0-9a-f]{40} --not --remotes=origin --no-color ' $WORK/calls
exec git -C $WORK/remote.git log --format=%s main
stdout '^add clean$'

# Refused, the remote unchanged: a term in a file.
cp $WORK/src/notes.txt notes.txt
exec git add notes.txt
exec git commit -q -m 'add notes'
! exec git push origin main
stderr '^piste leaks: 1 commit for origin \(generic markers, 2 lists, gitleaks\)$'
stderr '^✗ [0-9a-f]{7} notes.txt:1  "Plum-Orchard" \(overlays/personal/leak-markers.txt\)$'
stderr '^Push blocked: take these out of the commits \(amend or rebase\), then push again.$'
cp stderr $WORK/hook.out
exec git -C $WORK/remote.git log --format=%s main
! stdout 'add notes'

# piste leaks agrees with the hook.
! exec piste leaks
cp stdout $WORK/cli.out
exec sh -c 'grep "^✗" "$WORK/hook.out" > "$WORK/a" && grep "^✗" "$WORK/cli.out" > "$WORK/b" && cmp "$WORK/a" "$WORK/b"'
exec git reset -q --hard origin/main

# Only in the message.
cp $WORK/src/ok.txt ok2.txt
exec git add ok2.txt
exec git commit -q -m 'from the plum orchard'
! exec git push origin main
stderr '^✗ [0-9a-f]{7} commit message  "plum orchard" \(overlays/personal/leak-markers.txt\)$'
exec git -C $WORK/remote.git log --format=%s main
! stdout 'plum orchard'
exec git reset -q --hard origin/main

# Only in a file name.
cp $WORK/src/ok.txt plum_orchard.txt
exec git add plum_orchard.txt
exec git commit -q -m 'add a file'
! exec git push origin main
stderr '^✗ [0-9a-f]{7} plum_orchard.txt \(name\)  "plum_orchard" \(overlays/personal/leak-markers.txt\)$'
exec git -C $WORK/remote.git log --format=%s main
! stdout 'add a file'
exec git reset -q --hard origin/main

# In a middle commit, taken out by the next: still refused, on that commit.
cp $WORK/src/notes.txt notes.txt
exec git add notes.txt
exec git commit -q -m 'middle'
cp $WORK/src/ok.txt notes.txt
exec git commit -q -am 'later'
! exec git push origin main
stderr -count=1 '^✗ '
cp stderr $WORK/push.out
exec sh -c 'grep -q "^✗ $(git rev-parse HEAD~1 | cut -c1-7) notes.txt:1 " "$WORK/push.out"'
exec git -C $WORK/remote.git log --format=%s main
! stdout 'middle'
exec git reset -q --hard origin/main

# Only in the work overlay's list.
cp $WORK/src/tern.txt tern.txt
exec git add tern.txt
exec git commit -q -m 'add tern'
! exec git push origin main
stderr '^✗ [0-9a-f]{7} tern.txt:1  "Hidden_Tern" \(overlays/work/leak-markers.personal.txt\)$'
exec git reset -q --hard origin/main

# A forced add under overlays/.
cp $WORK/src/ok.txt overlays/work/notes.txt
exec git add -f overlays/work/notes.txt
exec git commit -q -m 'add overlay notes'
! exec git push origin main
stderr '^✗ [0-9a-f]{7} overlays/work/notes.txt +under overlays/: an overlay.s files never go in the engine$'
exec git -C $WORK/remote.git log --format=%s main
! stdout 'add overlay notes'
exec git reset -q --hard origin/main

# From a linked worktree (its own .piste, no overlays): the main checkout's
# lists apply, through the worktree's own copy of the hook.
exec git worktree add -q ../wt -b side
cd ../wt
cp $WORK/src/notes.txt notes.txt
exec git add notes.txt
exec git commit -q -m 'side notes'
! exec git push origin side
stderr '^✗ [0-9a-f]{7} notes.txt:1  "Plum-Orchard" \(overlays/personal/leak-markers.txt\)$'
exec git reset -q --hard main
exec git push -q origin side
stderr '^piste leaks: 0 commits for origin clean'

# Deleting a branch scans nothing.
cd ../co
exec git push -q origin :side
exec git -C $WORK/remote.git branch --list side
! stdout side

# No list: nothing checked, the push blocked.
mv overlays/personal/leak-markers.txt $WORK/saved-personal.txt
mv overlays/work/leak-markers.personal.txt $WORK/saved-work.txt
cp $WORK/src/ok.txt ok3.txt
exec git add ok3.txt
exec git commit -q -m 'ok three'
! exec git push origin main
stderr '^piste leaks: no marker list \(overlays/\*/leak-markers\*.txt\); nothing checked, push blocked$'
exec git -C $WORK/remote.git log --format=%s main
! stdout 'ok three'
mv $WORK/saved-personal.txt overlays/personal/leak-markers.txt
mv $WORK/saved-work.txt overlays/work/leak-markers.personal.txt

# A gitleaks finding blocks; so does gitleaks failing.
cp $WORK/gitleaks-git.json $WORK/replies/gitleaks-git
env SHIM_EXIT_GITLEAKS=3
! exec git push origin main
stderr '^✗ abcdef0 ok3.txt:1  gitleaks: generic-api-key \(redacted\)$'
stderr '^Push blocked'
env SHIM_EXIT_GITLEAKS=2
! exec git push origin main
stderr '^piste leaks: gitleaks failed \(exit 2\).*; push blocked$'
env SHIM_EXIT_GITLEAKS=
rm $WORK/replies/gitleaks-git
exec git -C $WORK/remote.git log --format=%s main
! stdout 'ok three'
exec git push -q origin main

# <dir> mode: an exported tree, every file; an overlays/ in it is refused.
! exec piste leaks $WORK/tree
stdout '^piste leaks: 1 file in .*/tree \(generic markers, 2 lists, gitleaks\)$'
stdout '^✗ .*/tree/hit.txt:1  "plum orchard" \(overlays/personal/leak-markers.txt\)$'
stdout '^✗ .*/tree/overlays +an overlays/ directory: scan an exported tree, not a checkout$'
stdout '^Take these out of the tree.$'
exec piste leaks $WORK/tree1
stdout '^piste leaks: 1 file in .*/tree1 clean \(generic markers, 2 lists, gitleaks\)$'

# Outside a checkout only --markers lists apply.
cd $WORK
exec piste leaks tree2
stdout 'piste leaks: 1 file in tree2 clean \(generic markers, 0 lists, gitleaks\)'
! exec piste leaks --markers $WORK/work-markers.txt tree2
stdout '^✗ tree2/x.txt:1  "Hidden Tern" \(.*/work-markers.txt\)$'
stdout '1 list,'

# A gitleaks finding is a hit; gitleaks failing is exit 2.
cp gitleaks-finding.json replies/gitleaks-dir
env SHIM_EXIT_GITLEAKS=3
! exec piste leaks tree1
stdout '^✗ tree1/a.txt:3  gitleaks: generic-api-key \(redacted\)$'
env SHIM_EXIT_GITLEAKS=2
! exec piste leaks tree1
stderr '^piste leaks: gitleaks failed \(exit 2\)'
exec sh -c 'piste leaks tree1 2>/dev/null; echo $?'
stdout '^2$'
env SHIM_EXIT_GITLEAKS=

-- mk.sh --
set -e
mkdir -p replies
git init -q --bare remote.git
mkdir co && cd co
git init -q -b main
git config user.name t
git config user.email t@example.com
git config commit.gpgsign false
mkdir -p overlays/personal overlays/work
printf '# made-up words\nplum orchard\nre:\\bbox[0-9]\n' > overlays/personal/leak-markers.txt
cp ../work-markers.txt overlays/work/leak-markers.personal.txt
touch .piste
mkdir .githooks
cp "$GITHOOKS/pre-push" .githooks/pre-push
git config core.hooksPath .githooks
printf '/overlays/\n' > .gitignore
echo hello > README.md
git add -A
git commit -q -m init
git remote add origin ../remote.git
git push -q origin main
mkdir ../src
printf 'Plum-Orchard\n' > ../src/notes.txt
printf 'Hidden_Tern\n' > ../src/tern.txt
printf 'fine\n' > ../src/ok.txt
-- work-markers.txt --
re:\bbox[0-9]
Hidden Tern
-- bad.txt --
fine
one two three four five
-- hashed.txt --
fine
sha256:b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9
-- tree/hit.txt --
plum orchard
-- tree/overlays/x/f --
anything
-- tree1/a.txt --
ok
-- tree2/x.txt --
Hidden Tern
-- gitleaks-git.json --
[{"RuleID": "generic-api-key", "File": "ok3.txt", "StartLine": 1, "Commit": "abcdef0123456789abcdef0123456789abcdef01"}]
-- gitleaks-finding.json --
[{"RuleID": "generic-api-key", "File": "tree1/a.txt", "StartLine": 3, "Commit": ""}]
