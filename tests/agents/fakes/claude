#!/usr/bin/env python3
"""Fake `claude plugin ...` for tests/agents: state in $FAKE_CLAUDE_STATE, calls
appended to $FAKE_CLAUDE_STATE.log."""
import json, os, sys
from pathlib import Path

state_path = Path(os.environ["FAKE_CLAUDE_STATE"])
state = json.loads(state_path.read_text()) if state_path.exists() else {"marketplaces": {}, "plugins": {}}
args = [a for a in sys.argv[1:] if a != "--json"]
with open(str(state_path) + ".log", "a") as log:
    log.write(" ".join(sys.argv[1:]) + "\n")


def plugin_version(market, name):
    root = Path(state["marketplaces"][market]["path"])
    return json.loads((root / name / ".claude-plugin" / "plugin.json").read_text())["version"]


match args:
    case ["plugin", "marketplace", "list"]:
        print(json.dumps([{"name": n, "source": "directory", **m} for n, m in state["marketplaces"].items()]))
    case ["plugin", "list"]:
        print(json.dumps([{"id": i, **p} for i, p in state["plugins"].items()]))
    case ["plugin", "marketplace", "add", path]:
        name = json.loads((Path(path) / ".claude-plugin" / "marketplace.json").read_text())["name"]
        state["marketplaces"][name] = {"path": path}
    case ["plugin", "marketplace", "update", name]:
        # Like claude: a directory marketplace whose source is gone can't update.
        if not Path(state["marketplaces"][name]["path"]).is_dir():
            print(f"fake claude: marketplace {name}: source {state['marketplaces'][name]['path']} not found", file=sys.stderr)
            sys.exit(1)
    case ["plugin", "marketplace", "remove", name]:
        # Like claude: removing a marketplace uninstalls its plugins.
        state["marketplaces"].pop(name)
        state["plugins"] = {i: p for i, p in state["plugins"].items() if not i.endswith("@" + name)}
    case ["plugin", "install", pid, *_] | ["plugin", "update", pid]:
        name, market = pid.split("@")
        state["plugins"][pid] = {"version": plugin_version(market, name), "enabled": True, "scope": "user"}
    case ["plugin", "enable", pid]:
        state["plugins"][pid]["enabled"] = True
    case ["plugin", "uninstall", pid]:
        state["plugins"].pop(pid)
    case _:
        print(f"fake claude: unsupported {args}", file=sys.stderr)
        sys.exit(2)
state_path.write_text(json.dumps(state))
