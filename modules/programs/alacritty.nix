{ config, pkgs, lib, ... }:

let
  fontSize = if pkgs.stdenv.hostPlatform.isDarwin then 14 else 10;
in
{
  programs.alacritty = {
    # The package is GL-dependent: on by default on a Mac, a choice on Linux.
    enable = lib.mkDefault pkgs.stdenv.hostPlatform.isDarwin;
    settings = {
      cursor = {
        style = "Block";
      };

      window = {
        opacity = 1.0;
        padding = {
          x = 24;
          y = 24;
        };
      };

      font = {
        normal = {
          family = "MesloLGS NF";
          style = "Regular";
        };
        size = fontSize;
      };

      dynamic_padding = true;
      decorations = "full";
      title = "Terminal";
      class = {
        instance = "Alacritty";
        general = "Alacritty";
      };

      # Shift+Enter sends newline through Zellij (bracketed paste workaround)
      keyboard = {
        bindings = [
          { key = "Return"; mods = "Shift"; chars = "\\x1b[200~\\n\\x1b[201~"; }
        ];
      };

      colors = {
        primary = {
          background = "0x1f2528";
          foreground = "0xc0c5ce";
        };

        normal = {
          black = "0x1f2528";
          red = "0xec5f67";
          green = "0x99c794";
          yellow = "0xfac863";
          blue = "0x6699cc";
          magenta = "0xc594c5";
          cyan = "0x5fb3b3";
          white = "0xc0c5ce";
        };

        bright = {
          black = "0x65737e";
          red = "0xec5f67";
          green = "0x99c794";
          yellow = "0xfac863";
          blue = "0x6699cc";
          magenta = "0xc594c5";
          cyan = "0x5fb3b3";
          white = "0xd8dee9";
        };
      };
    };
  };
}
